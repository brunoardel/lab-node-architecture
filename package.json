{
  "name": "lab-node-architecture",
  "version": "1.0.0",
  "description": "Lab de Arquitetura Backend de Alta Concorrência em Node.js e TypeScript",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "architecture",
    "concurrency",
    "fastify",
    "streams",
    "worker-threads"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
